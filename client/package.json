{
  "name": "ror-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:frontend": "biome ci --error-on-warnings .",
    "test": "vitest run",
    "check:rust": "npm run check:rust:fmt && npm run check:rust:clippy",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "format:frontend": "biome format --write .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "tauri": "tauri"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
